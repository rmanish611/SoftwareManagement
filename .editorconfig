root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csproj,props,targets}]
indent_size = 4

[*.{ps1,cmd,sln}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:error
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:error

# Nullability and correctness - these are the ones that catch real bugs
dotnet_diagnostic.CS8618.severity = error
dotnet_diagnostic.CS8625.severity = error
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1062.severity = error
dotnet_diagnostic.CA2016.severity = error

# Style the build enforces
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = true:error
dotnet_style_readonly_field = true:warning
csharp_style_prefer_primary_constructors = false:suggestion
dotnet_diagnostic.IDE0055.severity = warning

[backend/tests/**.cs]
# The exit gate (D3) requires test method names that carry the requirement id and the
# expected outcome, for example REQ_LEAD_004_Returns400_WhenCaptchaTokenIsReplayed. That
# naming is mandated by the approved protocol, so CA1707 (no underscores in member names)
# is scoped off for test projects only. Production code keeps it at error.
# This is a scope decision, not a suppression: no <NoWarn> and no #pragma exists anywhere.
dotnet_diagnostic.CA1707.severity = none

[backend/src/**/Persistence/Migrations/*.cs]
# EF Core generates these files and they are frozen once applied: a mistake is corrected by a
# new migration, never by hand-editing an applied one. Generated code cannot satisfy the style
# and nullable analysers that hand-written source must satisfy, so the rules are scoped off
# here and nowhere else.
#
# This is done with .editorconfig rather than <NoWarn> deliberately: a Directory.Build.props
# placed inside a project subfolder is never read by MSBuild (it only searches upward from the
# project file), so that approach silently does nothing. .editorconfig is genuinely path-scoped.
# Treat the whole directory as generated so every analyser skips it, rather than listing rules
# one at a time and rediscovering a new one on every migration.
generated_code = true
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.CS8618.severity = none
dotnet_diagnostic.CS8625.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.IDE0055.severity = none

[backend/src/**.cs]
# CA1711 reserves the suffix "Permission" for other purposes. Here `Permission` and
# `RolePermission` are the names the approved data model and authorization matrix use
# (03-data-model.md E-43/E-44, 06-authz.md), and the seeded table is called Permissions.
# Renaming the type to satisfy a naming heuristic would make the code disagree with the
# document it implements, so the suffix is allowed instead. No correctness rule is affected.
dotnet_code_quality.CA1711.allowed_suffixes = Permission
